{
  "name": "rainy",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:js": "eslint . --ext .js",
    "lint:css": "stylelint \"src/**/*.css\" \"public/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "format": "prettier --write .",
    "prepare": "husky install",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "jquery": "^4.0.0",
    "jquery.ripples": "^0.6.3",
    "rainyday": "^0.0.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "gh-pages": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "terser": "^5.48.0",
    "vite": "^5.0.0",
    "vitest": "^1.5.0"
  }
}
